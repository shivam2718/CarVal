# Backend Configuration
FASTAPI_HOST=localhost
FASTAPI_PORT=8000
FASTAPI_ENV=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# File Upload Configuration
MAX_IMAGE_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=20
UPLOAD_TEMP_DIR=./temp_uploads

# Vision Service Configuration (see services/vision/README.md)
VISION_SERVICE_URL=http://localhost:8001
VISION_MODEL_PATH=./weights/best.pt
VISION_CONFIDENCE_THRESHOLD=0.25
VISION_DEVICE=auto
# Folder where the backend saves uploaded images; lets the vision service resolve IDs like IMG-001
# VISION_IMAGE_DIR=./temp_uploads

# Document AI Configuration
DOCUMENT_AI_OCR_BACKEND=pytesseract
DOCUMENT_EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# Database (if needed for Review 3+)
DATABASE_URL=sqlite:///./carval.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/carval.log

# API Keys (Add as needed for external services in later reviews)
# LLM_API_KEY=your_key_here
# RAG_SERVICE_KEY=your_key_here
